<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="u3123004589.dao.UserDao">

    <!--将列映射到User实体-->
    <resultMap id="UserResultMap" type="u3123004589.entity.User">
        <id column="id" property="id"/>
        <result column="password" property="password"/>
        <result column="status" property="status"/>
    </resultMap>

    <!--插入用户-->
    <insert id="insertUser" parameterType="u3123004589.entity.User">
        insert into `user`(id, password, status)
        values (#{id}, #{password}, #{status})
    </insert>

    <select id="getUserById" parameterType="java.lang.String" resultMap="UserResultMap">
        select id, password, status
        from `user`
        where id = #{id}
    </select>

    <update id="updateLoginStatus">
        update `user`
        set status = #{status}
        where id = #{id}
    </update>

</mapper>